# Per-issue worktrees created by drain-cycle.
.worktrees/

# Per-session worker artefacts planted in a worktree root by the orchestrator
# and stop-guard. Never belong in a committed tree.
.drain-guard.json
.drain-guard-tripped
.drain-handoff.json
.drain-base
pickup-envelope.json
exec-state.json
# but the vendored test fixture of that file is a checked-in sample, not an artefact.
!tests/fixtures/exec-state.json

# Operator secrets (LINEAR_API_KEY etc).
.env

# Plan-review records are transient review artefacts, never committed.
docs/adrs/references/*-plan-review.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Atentic workflows
docs/tasks
docs/delivery-plans
.entire
.claude
.private-journal
